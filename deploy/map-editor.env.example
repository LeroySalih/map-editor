# Copy to deploy/map-editor.env (it is git-ignored) and edit. One KEY=value per line.
# Read by Docker Compose: VITE_* are baked into the editor at build time, MAP_* reach the server container.

# --- the editor (built in) ---
VITE_DINO_ISSUER=https://dino.mr-salih.org
VITE_DINO_CLIENT_ID=map-editor

# --- the map server ---
MAP_SSO_ISSUER=https://dino.mr-salih.org
MAP_SSO_CLIENT_ID=map-editor
# Must equal the Audience of the `map-editor` client in DINO, or every sign-in token is refused.
MAP_SSO_AUDIENCE=map-editor
# MAP_SSO_JWKS_URL=
# MAP_MAX_MAPS_PER_USER=200

# The port (5000), the database (/data/maps.db, a Docker volume) and the editor folder are fixed in docker-compose.yml.
