# Copy to deploy/map-editor.env (it is git-ignored) and edit. One KEY=value per line, no spaces, no quotes.
# Used by deploy.sh (VITE_* are baked into the editor at build time) and by the systemd unit (MAP_*).

# --- the editor (built in) ---
VITE_DINO_ISSUER=https://dino.mr-salih.org
VITE_DINO_CLIENT_ID=map-editor

# --- the map server ---
MAP_SSO_ISSUER=https://dino.mr-salih.org
MAP_SSO_CLIENT_ID=map-editor
MAP_SSO_AUDIENCE=kerf-sabre
# Keep the database OUTSIDE the checkout and back it up.
MAP_DB_PATH=/var/lib/map-editor/maps.db
# The built editor, served at / by the same process. Use the real path of this checkout.
MAP_STATIC_DIR=/opt/map-editor/dist
MAP_HOST=127.0.0.1
MAP_PORT=5000

# --- deploy.sh (optional) ---
# DEPLOY_SERVICE=map-editor
# DEPLOY_RESTART_CMD=systemctl restart map-editor
# DEPLOY_BRANCH=main
